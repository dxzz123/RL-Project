{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Train manuscript joint PPO (b=3, small run)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.paper_train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--updates",
        "10",
        "--episodes-per-update",
        "4",
        "--seed",
        "7",
        "--dispatch-critic-target",
        "dispatch",
        "--output-dir",
        "outputs/paper_joint_ppo"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train fitted-value dispatch (b=3)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.fitted_train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--seed",
        "7",
        "--grid-step",
        "10",
        "--samples",
        "8",
        "--output-dir",
        "outputs/fitted_value"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train SA-PPO–MAPPO (small run)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.train",
      "args": [
        "--updates",
        "10",
        "--episodes-per-update",
        "4",
        "--seed",
        "7",
        "--output-dir",
        "outputs/sa_ppo_mappo"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train SA-PPO–MAPPO (long run with validation)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.train",
      "args": [
        "--updates",
        "500",
        "--episodes-per-update",
        "16",
        "--epochs",
        "6",
        "--minibatch-size",
        "192",
        "--learning-rate",
        "0.0003",
        "--critic-learning-rate",
        "0.001",
        "--value-clip",
        "0",
        "--entropy-coef",
        "0.005",
        "--eval-episodes",
        "32",
        "--eval-interval",
        "25",
        "--eval-policy",
        "stochastic",
        "--seed",
        "7",
        "--output-dir",
        "outputs/sa_ppo_mappo_long"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Travel to FCS and discharge",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/fcs_discharge_walkthrough.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Manual environment walkthrough",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/manual_walkthrough.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Verify Gymnasium interface",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/check_gym.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
