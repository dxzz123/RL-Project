{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Show current scorecard (study 11, learned pricing)",
      "program": "${workspaceFolder}/experiments/run_priced_adp_study.py",
      "args": [
        "--phase",
        "show",
        "--study-dir",
        "outputs/priced_adp_study_20261025"
      ],
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run rollout ADP (small city, 4 days)",
      "module": "charging_env.rl.rollout_adp",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--seed",
        "7",
        "--price-index",
        "4",
        "--rollout-samples",
        "8",
        "--episodes",
        "4",
        "--eval-seed-base",
        "801000001",
        "--output-dir",
        "outputs/rollout_adp"
      ],
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Fit Table ADP (small city)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.fitted_train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--seed",
        "7",
        "--grid-step",
        "10",
        "--samples",
        "8",
        "--output-dir",
        "outputs/table_adp"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train Joint PPO (small city, short check)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.paper_train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--updates",
        "10",
        "--episodes-per-update",
        "4",
        "--seed",
        "7",
        "--dispatch-critic-target",
        "dispatch",
        "--output-dir",
        "outputs/joint_ppo"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train earlier PPO (small city, short check)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--dispatch-final-activation",
        "silu",
        "--updates",
        "10",
        "--episodes-per-update",
        "4",
        "--seed",
        "7",
        "--output-dir",
        "outputs/earlier_ppo"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Show saved algorithm comparison (study 07)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/summarize_paper_ppo_study.py",
      "args": [
        "--show"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Manual environment walkthrough",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/manual_walkthrough.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Travel to FCS and discharge",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/fcs_discharge_walkthrough.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Verify Gymnasium interface",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/check_gym.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
