{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Show saved algorithm comparison",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/experiments/summarize_paper_ppo_study.py",
      "args": [
        "--show"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train manuscript joint PPO (b=3, small run)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.paper_train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--updates",
        "10",
        "--episodes-per-update",
        "4",
        "--seed",
        "7",
        "--dispatch-critic-target",
        "dispatch",
        "--output-dir",
        "outputs/paper_joint_ppo"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train approximate DP / fitted value (b=3)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.fitted_train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--seed",
        "7",
        "--grid-step",
        "10",
        "--samples",
        "8",
        "--output-dir",
        "outputs/fitted_value"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Train earlier PPO/MAPPO (b=3, small run)",
      "type": "debugpy",
      "request": "launch",
      "module": "charging_env.rl.train",
      "args": [
        "--scenario",
        "configs/utility_b3.json",
        "--dispatch-final-activation",
        "silu",
        "--updates",
        "10",
        "--episodes-per-update",
        "4",
        "--seed",
        "7",
        "--output-dir",
        "outputs/earlier_ppo"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Travel to FCS and discharge",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/fcs_discharge_walkthrough.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Manual environment walkthrough",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/manual_walkthrough.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Verify Gymnasium interface",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/check_gym.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
